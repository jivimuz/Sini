{
  "expo": {
    "name": "Sini",
    "slug": "Sini",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Sini-icon.webp",
    "scheme": "sini",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/Sini-icon.webp",
      "supportsTablet": true,
      "bundleIdentifier": "com.sini.app"
    },
    "android": {
      "package": "com.sini.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/Sini-logo.webp",
        "backgroundImage": "./assets/images/Sini-logo.webp",
        "monochromeImage": "./assets/images/Sini-logo.webp"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/Sini-icon.webp"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/Sini-icon.webp",
            "imageWidth": 76
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}