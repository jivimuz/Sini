{
  "expo": {
    "name": "Sini",
    "slug": "Sini",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Sini-logo.jpg",
    "scheme": "sini",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/Sini-logo.jpg",
      "supportsTablet": true,
      "bundleIdentifier": "com.sini.app"
    },
    "android": {
      "package": "com.sini.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/Sini-logo.jpg",
        "backgroundImage": "./assets/images/Sini-icon.png",
        "monochromeImage": "./assets/images/Sini-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/Sini-icon.png",
      "web": {
        "bundler": "metro"
      }
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      "expo-secure-store",
      "@maplibre/maplibre-react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0b7e3b8a-8279-4ab8-ad20-fb51998382a4"
      }
    }
  }
}
